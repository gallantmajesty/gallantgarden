# Supabase — copy to .env.local and fill in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth (also configure in Supabase Dashboard → Auth → Providers)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Spotify (create an app at https://developer.spotify.com/dashboard)
# Add http://localhost:5173/realm as a redirect URI in Spotify Dashboard
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Owner Panel PIN (pick something secure — only you know this)
VITE_OWNER_PIN=your-admin-pin-here
